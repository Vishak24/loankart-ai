# LoanKart.ai backend configuration.
# Copy this file to backend/.env and fill in what you need. backend/.env is read at start-up and is git-ignored.
# Real environment variables take precedence over this file. Never put real keys in .env.example.
# Nothing here is needed for the demo: with every value empty the app runs fully in mock mode.

# ---- Core -------------------------------------------------------------------------------------
# SQLite file. Generated PDFs and uploads are stored in a "files" folder next to it. Default: backend/data/loankart.db
LOANKART_DB_PATH=
# Comma-separated browser origins allowed to call the API.
LOANKART_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# mock = no external calls (default). live = use the AI providers configured below.
# This is the start-up default; it can be switched at runtime on the /demo-control page.
LOANKART_AI_MODE=mock
# Which live provider writes explanations: claude (default) or sarvam. The other one is the automatic second choice.
LOANKART_REASONING_PROVIDER=claude
# Pause between investigation steps, in milliseconds, so the timeline can be followed. 0 disables it.
LOANKART_DEMO_PACING_MS=350

# ---- Anthropic (Claude): explanations, summaries, proposal and query drafting ------------------
ANTHROPIC_API_KEY=
# Model ID. Default claude-opus-5-5. Use a current Claude model ID exactly as documented (no date suffix).
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Sarvam AI: chat, speech, translation, document OCR ----------------------------------------
# Model IDs below are the ones in docs.sarvam.ai on 15 Nov 2026.
SARVAM_API_KEY=
SARVAM_CHAT_MODEL=sarvam-105b
# Speech-to-text. saaras:v4 is the documented default; saaras:v3 is also available.
SARVAM_STT_MODEL=saaras:v4
# Text-to-speech. bulbul:v4-flash is the documented latest; bulbul:v3 is also available.
SARVAM_TTS_MODEL=bulbul:v4-flash
# Optional voice name for text-to-speech. Empty uses the model's default voice.
SARVAM_TTS_SPEAKER=
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
# Sarvam Vision reads documents through the Document AI parse API, which takes no model name.
# SARVAM_VISION_MODEL is therefore not used. Set the switch below to 1 to OCR documents with Sarvam Vision
# in live mode instead of the built-in parser (slower; meant for scanned documents).
LOANKART_USE_SARVAM_VISION=0

# ---- Paytm (optional) ---------------------------------------------------------------------------
# The product uses a synthetic merchant fixture. These values only enable a connectivity check of Paytm's
# Settlement Summary API (production only). See API_SETUP.md.
PAYTM_MERCHANT_ID=
# Client ID and JWT access token for Paytm's settlement APIs, issued by Paytm for the merchant account.
PAYTM_CLIENT_ID=
PAYTM_ACCESS_TOKEN=
# Payment Gateway merchant key and environment (staging or production). Read but not used: LoanKart takes no payments.
PAYTM_MERCHANT_KEY=
PAYTM_ENVIRONMENT=staging
