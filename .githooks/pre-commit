#!/bin/sh
# Blocks the two ways a secret reaches this repo: a real value in a *.env.example file, and anything gitleaks recognises.
# Enable once per clone:  git config core.hooksPath .githooks
bad=$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)\.env\.example$' | while read -r f; do
  git show ":$f" | grep -nE '^[A-Za-z0-9_]*(KEY|TOKEN|SECRET|PASSWORD|PASSCODE)[A-Za-z0-9_]*=[^[:space:]#]+' | sed "s|^|$f:|; s|=.*|=<value hidden>|"
done)
if [ -n "$bad" ]; then
  echo "COMMIT BLOCKED: a secret-looking setting has a value in an .env.example file (values hidden):" >&2
  echo "$bad" >&2
  echo "Move the value to backend/.env (git-ignored) and leave the example empty. Treat the value as exposed and rotate it." >&2
  exit 1
fi
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner || { echo "COMMIT BLOCKED by gitleaks." >&2; exit 1; }
else
  echo "warning: gitleaks not installed; only the .env.example check ran." >&2
fi
