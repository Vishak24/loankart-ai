# ---- Secrets: never commit. Only the *.example templates (which must hold no real values) are tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json

# ---- Local data: SQLite databases, backups, uploads and generated PDFs (all regenerated by the app)
backend/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.bak
*.dump

# ---- Python
backend/.venv/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Node / frontend
node_modules/
frontend/dist/
*.tsbuildinfo
.vite/
npm-debug.log*

# ---- Logs and temporary files
*.log
logs/
tmp/
*.tmp
*.swp

# ---- OS and IDE
.DS_Store
.idea/
.vscode/
*.code-workspace

# ---- Tool output and non-source documents (keep local)
.claude/
graphify-out/
*.docx

# Cloudflare Wrangler local state
.wrangler/
